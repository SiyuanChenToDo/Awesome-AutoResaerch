{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Imported research catalog record",
  "type": "object",
  "required": [
    "id",
    "kind",
    "title",
    "url",
    "categories",
    "source_mentions",
    "verification_status",
    "integration_status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "tool",
        "paper",
        "resource"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "benchmark",
          "community",
          "curated-list",
          "domain-science",
          "end-to-end",
          "experiment-loop",
          "foundation",
          "hypothesis",
          "industry",
          "infrastructure",
          "literature",
          "other",
          "paper-system",
          "risk-governance",
          "skills-writing",
          "survey"
        ]
      }
    },
    "verification_status": {
      "const": "source_imported"
    },
    "integration_status": {
      "const": "not_integrated"
    },
    "source_mentions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "path",
          "line",
          "section",
          "label",
          "original_url",
          "source_excerpt"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "section": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "original_url": {
            "type": "string",
            "format": "uri"
          },
          "source_excerpt": {
            "type": "string"
          }
        }
      }
    }
  }
}
